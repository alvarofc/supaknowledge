{
  "name": "supaknowledge",
  "private": true,
  "description": "Supaknowledge: an open-source knowledge factory built on Supabase",
  "homepage": "https://github.com/alvarofc/supaknowledge#readme",
  "bugs": {
    "url": "https://github.com/alvarofc/supaknowledge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarofc/supaknowledge.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && node scripts/link-cli.mjs",
    "build:cli": "npm run build -w @supaknowledge/cli && node scripts/link-cli.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "check:functions": "node scripts/check-functions.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:deno": "node scripts/test-deno.mjs",
    "test:python": "cd sdks/python && uv venv -q --allow-existing && uv pip install -q -e '.[test]' && .venv/bin/python -m pytest -q",
    "test:db": "supabase test db",
    "test:all": "npm run typecheck && npm test && npm run lint -w @supaknowledge/studio && npm run check:shared && npm run check:functions && npm run test:deno && npm run test:python && npm run test:db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/.env",
    "studio": "npm run dev -w @supaknowledge/studio",
    "demo": "npm run demo -w @supaknowledge/example-revenue-report --",
    "demo:offline": "npm run offline -w @supaknowledge/example-revenue-report --",
    "eval": "npm run eval -w @supaknowledge/example-evals --",
    "eval:offline": "npm run offline -w @supaknowledge/example-evals --"
  },
  "devDependencies": {
    "supabase": "^3.4.0",
    "typescript": "6.0.3",
    "@types/node": "^24.10.0"
  }
}
