# Supabase project used by Studio. Local defaults come from `supabase status` (npm run db:start).
# Vite exposes only VITE_* variables to the app and inlines them at build time.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only (not VITE_*): read at runtime by the auth routes that redirect after sign-in / sign-out.
# SITE_URL: Studio's public URL. Set it in production so redirects never depend on request headers.
# SITE_URL=https://studio.example.com
# TRUST_PROXY: set to 1 only behind a reverse proxy that overwrites X-Forwarded-Host / X-Forwarded-Proto.
# TRUST_PROXY=1
# KF_DEMO: set to true only on a public demo deployment; the sign-in page then offers "Try the demo" (an anonymous
# Supabase Auth session that joins the demo space as a reader). See docs/deploy.md#host-a-public-demo.
# KF_DEMO=true
