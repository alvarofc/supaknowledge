# Copy to supabase/.env (read by `supabase start` for env() values in config.jsonc)
KF_INTERNAL_SECRET=local-dev-internal-secret-change-me

# --- Curator model (any provider, through Mastra). Pick ONE of the options. ---
# Option A: your own OpenAI-compatible endpoint (vLLM, LiteLLM, Ollama, Azure, an internal gateway...)
#   KF_LLM_MODEL=acme/your-model-id      (the part after "/" is sent as the model name)
#   KF_LLM_BASE_URL=https://llm.example.com/v1
#   KF_LLM_API_KEY=...
#   KF_LLM_HEADERS={"x-team":"knowledge"}   (optional, JSON)
#   KF_LLM_API=chat                       (or "responses")
#   KF_LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'   (optional, vLLM/Qwen: no thinking)
# Option B: Vercel AI Gateway
#   KF_LLM_MODEL=vercel/openai/gpt-6.2-sol
#   AI_GATEWAY_API_KEY=...
KF_LLM_MODEL=
KF_LLM_FAST_MODEL=
KF_LLM_FALLBACK_MODELS=
KF_LLM_BASE_URL=
KF_LLM_API_KEY=
KF_LLM_HEADERS=
KF_LLM_API=
KF_LLM_EXTRA_BODY=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=

# Restrict the model ids space settings (curator.model / fast_model / fallback_models) may pick.
#   Comma separated, "prefix/*" wildcards, e.g. acme/*,vercel/openai/gpt-6.2-sol. Empty = any model id.
KF_LLM_ALLOWED_MODELS=
# Wall-clock budget per curator task, ms (default 110000; Supabase cuts functions off at 150 s on the free plan,
# 400 s on paid plans, so up to 380000 there).
KF_CURATOR_TASK_BUDGET_MS=
# Operator ceiling on model tokens (input + output) per curator run; curator.max_tokens_per_run in space settings
# can only go lower. Empty/0 = the space setting alone.
KF_LLM_MAX_TOKENS_PER_RUN=
# Minimum seconds between two manual curator runs of one space through POST /curator/run (default 120; HTTP 429
# with Retry-After until then).
KF_CURATOR_RUN_COOLDOWN_S=

# --- Public URL ---
# Origin of the API as MCP clients see it, e.g. https://<ref>.supabase.co. Locally SUPABASE_URL is the internal
# http://kong:8000, so MCP falls back to validated request headers; set this in production / behind a proxy.
KF_PUBLIC_URL=
# Fallback for KF_PUBLIC_URL (some self-hosted setups already define it).
SUPABASE_PUBLIC_URL=

# --- Connectors ---
# Token for public GitHub repos when a source has no token of its own (only used for api.github.com).
GITHUB_TOKEN=
# Cap on any upstream response body a connector buffers, bytes (default 20971520 = 20 MiB).
KF_CONNECTOR_MAX_BYTES=
# Connectors refuse private / loopback / link-local / internal hosts (SSRF guard). Set to true ONLY for
# self-hosted or dev setups that sync intranet sites.
KF_CONNECTORS_ALLOW_PRIVATE_NETWORK=
# Send every connector request through this HTTP proxy (http://[user:pass@]host:port), which must itself refuse
# non-public destinations (e.g. Smokescreen): closes the DNS-rebinding gap of the in-function SSRF checks.
KF_CONNECTORS_EGRESS_PROXY=

# --- Embeddings ---
# New chunks embedded per `embed` request (gte-small runs on the worker CPU, ~2 s per request; default 4).
KF_EMBEDS_PER_REQUEST=
