# Copy to supabase/.env (read by `supabase start` for env() values in config.jsonc)
KF_INTERNAL_SECRET=local-dev-internal-secret-change-me

# --- Curator model (any provider, through Mastra). Pick ONE of the options. ---
# Option A: your own OpenAI-compatible endpoint (vLLM, LiteLLM, Ollama, Azure, an internal gateway...)
#   KF_LLM_MODEL=acme/your-model-id      (the part after "/" is sent as the model name)
#   KF_LLM_BASE_URL=https://llm.example.com/v1
#   KF_LLM_API_KEY=...
#   KF_LLM_HEADERS={"x-team":"knowledge"}   (optional, JSON)
#   KF_LLM_API=chat                       (or "responses")
#   KF_LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'   (optional, vLLM/Qwen: no thinking)
# Option B: Vercel AI Gateway
#   KF_LLM_MODEL=vercel/openai/gpt-6.2-sol
#   AI_GATEWAY_API_KEY=...
KF_LLM_MODEL=
KF_LLM_FAST_MODEL=
KF_LLM_FALLBACK_MODELS=
KF_LLM_BASE_URL=
KF_LLM_API_KEY=
KF_LLM_HEADERS=
KF_LLM_API=
KF_LLM_EXTRA_BODY=
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=

GITHUB_TOKEN=
