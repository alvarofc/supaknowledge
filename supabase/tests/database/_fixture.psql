-- Shared fixture for the access-control tests. Included with `\ir _fixture.psql` from every *.test.sql file,
-- INSIDE the test transaction (so everything here is rolled back). Not a test file itself (pg_prove only
-- runs *.sql).
--
-- World:
--   workspace A ("acme")                         workspace B ("bobco")
--     owner_a (owner), admin_a (admin),            owner_b (owner), member_b (member)
--     member_a (member), everyone below (member)   space s2 (visibility workspace)
--   groups in A: finance, eng, revgrp              group in B: bgrp
--   space s1 (private) direct roles:
--     s_reader reader, agent reader (kind=agent), s_editor editor, s_reviewer reviewer, s_admin admin
--     fin_reader reader, fin_editor editor, fin_reviewer reviewer, fin_admin admin  (all four in finance)
--     grp_reviewer: reviewer through a group grant (revgrp -> reviewer)
--   space s_open (A, visibility workspace): every A member reads
--   outsider: an authenticated user with no memberships at all
--
-- Knowledge in s1: c_pub (audience {}), c_fin (audience {finance}) with revisions, chunks, links, files,
-- verifications. Evidence: src_pub/src_fin, doc_pub/doc_fin, chunks, traces, flags, a proposal citing
-- finance evidence. Mirrors exist in s2 (workspace B).

create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to authenticated, service_role, anon;
create table tests.ids (name text primary key, id uuid not null);
grant select on tests.ids to authenticated, service_role, anon;

create function tests.id(p text) returns uuid language sql stable as $$
  select id from tests.ids where name = p;
$$;

create function tests.put(p text, v uuid) returns uuid language sql as $$
  insert into tests.ids values (p, v) returning id;
$$;

create function tests.mkuser(p text, p_agent boolean default false) returns uuid language plpgsql as $$
declare
  v uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, email, aud, role, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (v, '00000000-0000-0000-0000-000000000000', p || '-' || v || '@test.local', 'authenticated', 'authenticated',
          case when p_agent then '{"kind":"agent"}' else '{}' end::jsonb, '{}'::jsonb, now(), now());
  insert into tests.ids values (p, v);
  return v;
end;
$$;

-- impersonate a user the way PostgREST does (role + jwt claims)
create function tests.as_user(p text) returns void language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims', json_build_object('sub', tests.id(p), 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', '', true);
end;
$$;

-- the Edge Functions' service-role client
create function tests.as_service() returns void language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  perform set_config('request.jwt.claim.sub', '', true);
end;
$$;

create function tests.as_postgres() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end;
$$;

do $fixture$
declare
  ws_a uuid; ws_b uuid; s1 uuid; s_open uuid; s2 uuid;
  g_fin uuid; g_eng uuid; g_rev uuid; g_b uuid;
  c_pub uuid; c_fin uuid; c_open uuid; c_b uuid;
  src_pub uuid; src_fin uuid; src_b uuid; doc_pub uuid; doc_fin uuid; doc_b uuid;
  u text;
  v uuid;
begin
  perform tests.mkuser(x) from unnest(array['owner_a','admin_a','member_a','s_reader','s_editor','s_reviewer','s_admin',
    'fin_reader','fin_editor','fin_reviewer','fin_admin','grp_reviewer','owner_b','member_b','outsider']) x;
  perform tests.mkuser('agent', true);

  insert into public.workspaces (slug, name) values ('acme-test', 'Acme') returning id into ws_a;
  insert into public.workspaces (slug, name) values ('bobco-test', 'Bobco') returning id into ws_b;
  perform tests.put('ws_a', ws_a); perform tests.put('ws_b', ws_b);

  insert into public.workspace_members (workspace_id, user_id, role) values
    (ws_a, tests.id('owner_a'), 'owner'), (ws_a, tests.id('admin_a'), 'admin'),
    (ws_b, tests.id('owner_b'), 'owner'), (ws_b, tests.id('member_b'), 'member');
  foreach u in array array['member_a','s_reader','s_editor','s_reviewer','s_admin','fin_reader','fin_editor','fin_reviewer',
                           'fin_admin','grp_reviewer','agent'] loop
    insert into public.workspace_members (workspace_id, user_id, role) values (ws_a, tests.id(u), 'member');
  end loop;
  insert into public.agents (id, workspace_id, name) values (tests.id('agent'), ws_a, 'support-bot');

  insert into public.groups (workspace_id, slug, name) values (ws_a, 'finance', 'Finance') returning id into g_fin;
  insert into public.groups (workspace_id, slug, name) values (ws_a, 'eng', 'Eng') returning id into g_eng;
  insert into public.groups (workspace_id, slug, name) values (ws_a, 'revgrp', 'Reviewers') returning id into g_rev;
  insert into public.groups (workspace_id, slug, name) values (ws_b, 'bgrp', 'B group') returning id into g_b;
  perform tests.put('g_fin', g_fin); perform tests.put('g_eng', g_eng); perform tests.put('g_rev', g_rev); perform tests.put('g_b', g_b);
  insert into public.group_members (group_id, user_id)
  select g_fin, tests.id(x) from unnest(array['fin_reader','fin_editor','fin_reviewer','fin_admin']) x;
  insert into public.group_members (group_id, user_id) values
    (g_eng, tests.id('s_editor')), (g_rev, tests.id('grp_reviewer')), (g_b, tests.id('member_b'));

  insert into public.spaces (workspace_id, slug, name, visibility) values (ws_a, 's1', 'Space 1', 'private') returning id into s1;
  insert into public.spaces (workspace_id, slug, name, visibility) values (ws_a, 'open', 'Open', 'workspace') returning id into s_open;
  insert into public.spaces (workspace_id, slug, name, visibility) values (ws_b, 's2', 'Space 2', 'workspace') returning id into s2;
  perform tests.put('s1', s1); perform tests.put('s_open', s_open); perform tests.put('s2', s2);

  insert into public.space_members (space_id, user_id, role) values
    (s1, tests.id('s_reader'), 'reader'), (s1, tests.id('agent'), 'reader'), (s1, tests.id('s_editor'), 'editor'),
    (s1, tests.id('s_reviewer'), 'reviewer'), (s1, tests.id('s_admin'), 'admin'),
    (s1, tests.id('fin_reader'), 'reader'), (s1, tests.id('fin_editor'), 'editor'),
    (s1, tests.id('fin_reviewer'), 'reviewer'), (s1, tests.id('fin_admin'), 'admin');
  insert into public.space_group_grants (space_id, group_id, role) values (s1, g_rev, 'reviewer');

  -- knowledge
  insert into public.concepts (space_id, path, kind, type, title, description, body, audience, generated_by)
  values (s1, 'metrics/active-users', 'domain', 'Metric', 'Active users', 'How we count revenue-generating users',
          'Public revenue definition. See [ARR](finance/arr).', '{}', 'import:test') returning id into c_pub;
  insert into public.concepts (space_id, path, kind, type, title, description, body, audience, generated_by)
  values (s1, 'finance/arr', 'domain', 'Metric', 'ARR (confidential)', 'Annual recurring revenue',
          'SECRET revenue figure: ARR is 42M.', array[g_fin], 'import:test') returning id into c_fin;
  insert into public.concepts (space_id, path, kind, type, title, body, audience)
  values (s_open, 'open/handbook', 'domain', 'Guide', 'Handbook', 'Open revenue handbook', '{}') returning id into c_open;
  insert into public.concepts (space_id, path, kind, type, title, body, audience)
  values (s2, 'b/secret', 'domain', 'Guide', 'B secret', 'Bobco revenue secret', '{}') returning id into c_b;
  perform tests.put('c_pub', c_pub); perform tests.put('c_fin', c_fin); perform tests.put('c_open', c_open); perform tests.put('c_b', c_b);

  insert into public.concept_revisions (concept_id, space_id, revision, path, kind, type, title, description, body, frontmatter, tags, status, audience, actor)
  select c.id, c.space_id, c.revision, c.path, c.kind, c.type, c.title, c.description, c.body, c.frontmatter, c.tags, c.status, c.audience, 'import:test'
  from public.concepts c where c.id in (c_pub, c_fin, c_open, c_b);
  insert into public.concept_chunks (concept_id, space_id, revision, ord, heading, content)
  select c.id, c.space_id, 1, 0, c.title, c.body from public.concepts c where c.id in (c_pub, c_fin, c_open, c_b);
  insert into public.concept_links (space_id, from_concept, to_path, to_concept) values
    (s1, c_pub, 'finance/arr', c_fin), (s1, c_fin, 'metrics/active-users', c_pub);
  insert into public.concept_files (concept_id, space_id, path, storage_path) values
    (c_fin, s1, 'calc.py', s1 || '/' || c_fin || '/calc.py'), (c_pub, s1, 'notes.md', s1 || '/' || c_pub || '/notes.md');
  insert into public.verifications (concept_id, space_id, revision, actor, actor_user_id)
  values (c_fin, s1, 1, 'human:' || tests.id('fin_admin'), tests.id('fin_admin'));

  -- evidence
  insert into public.sources (space_id, connector, name, audience, secret_id)
  values (s1, 'slack', 'general', '{}', null) returning id into src_pub;
  insert into public.sources (space_id, connector, name, audience, secret_id)
  values (s1, 'slack', 'finance-channel', array[g_fin], vault.create_secret('xoxb-finance-token', 'kf_test_fin_' || gen_random_uuid())) returning id into src_fin;
  insert into public.sources (space_id, connector, name, audience) values (s2, 'notion', 'b-wiki', '{}') returning id into src_b;
  perform tests.put('src_pub', src_pub); perform tests.put('src_fin', src_fin); perform tests.put('src_b', src_b);
  insert into public.source_documents (source_id, space_id, external_id, title, content, content_hash, audience, storage_path)
  values (src_pub, s1, 'm1', 'General thread', 'general revenue chatter', 'h1', '{}', s1 || '/' || src_pub || '/m1.txt') returning id into doc_pub;
  insert into public.source_documents (source_id, space_id, external_id, title, content, content_hash, audience, storage_path)
  values (src_fin, s1, 'm2', 'Finance thread', 'SECRET revenue: board approved 42M', 'h2', array[g_fin], s1 || '/' || src_fin || '/m2.txt') returning id into doc_fin;
  insert into public.source_documents (source_id, space_id, external_id, title, content, content_hash, audience, storage_path)
  values (src_b, s2, 'b1', 'B doc', 'bobco revenue', 'h3', '{}', s2 || '/' || src_b || '/b1.txt') returning id into doc_b;
  perform tests.put('doc_pub', doc_pub); perform tests.put('doc_fin', doc_fin); perform tests.put('doc_b', doc_b);
  insert into public.source_chunks (document_id, space_id, ord, content) values
    (doc_pub, s1, 0, 'general revenue chatter'), (doc_fin, s1, 0, 'SECRET revenue: board approved 42M'), (doc_b, s2, 0, 'bobco revenue');

  insert into public.traces (space_id, principal_id, name, audience) values (s1, tests.id('agent'), 'agent run', '{}')
  returning id into v;
  perform tests.put('tr_agent', v);
  insert into public.trace_events (trace_id, space_id, seq, role, content) values (v, s1, 0, 'user', 'agent asked something');
  insert into public.traces (space_id, principal_id, name, audience) values (s1, tests.id('fin_editor'), 'finance run', array[g_fin])
  returning id into v;
  perform tests.put('tr_fin', v);
  insert into public.trace_events (trace_id, space_id, seq, role, content) values (v, s1, 0, 'user', 'SECRET finance prompt');
  insert into public.traces (space_id, principal_id, name, audience) values (s1, tests.id('s_editor'), 'editor run', '{}')
  returning id into v;
  perform tests.put('tr_editor', v);
  insert into public.traces (space_id, principal_id, name, audience) values (s2, tests.id('member_b'), 'b run', '{}')
  returning id into v;
  perform tests.put('tr_b', v);

  -- flags (inserted directly; flag_knowledge is tested separately)
  insert into public.flags (space_id, created_by, kind, concept_id, concept_path, observation, audience)
  values (s1, tests.id('fin_reader'), 'incorrect', c_fin, 'finance/arr', 'SECRET: ARR should be 43M', array[g_fin]) returning id into v;
  perform tests.put('flag_fin', v);
  insert into public.flags (space_id, created_by, kind, concept_id, concept_path, observation, audience)
  values (s1, tests.id('agent'), 'unclear', c_pub, 'metrics/active-users', 'what is active?', '{}') returning id into v;
  perform tests.put('flag_pub', v);
  insert into public.flags (space_id, created_by, kind, observation) values (s2, tests.id('member_b'), 'missing', 'b flag') returning id into v;
  perform tests.put('flag_b', v);

  -- proposals (curator-authored, inserted as the service would)
  insert into public.proposals (space_id, author, created_by, title) values (s1, 'curator/test', null, 'Update ARR') returning id into v;
  perform tests.put('prop_fin', v);
  insert into public.proposal_ops (proposal_id, ord, op, concept_id, path, base_revision, after)
  values (v, 0, 'update', c_fin, 'finance/arr', 1, '{"body":"ARR is 43M"}');
  insert into public.proposal_citations (proposal_id, label, ref_kind, ref_id, audience)
  values (v, 'fin-thread', 'source_document', doc_fin, array[g_fin]);
  update public.flags set status = 'in_proposal', proposal_id = v where id = tests.id('flag_fin');
  insert into public.proposals (space_id, author, created_by, title) values (s1, 'curator/test', null, 'Clarify active users') returning id into v;
  perform tests.put('prop_pub', v);
  insert into public.proposal_ops (proposal_id, ord, op, concept_id, path, base_revision, after)
  values (v, 0, 'update', c_pub, 'metrics/active-users', 1, '{"body":"Active = logged in within 28 days."}');
  insert into public.proposal_citations (proposal_id, label, ref_kind, ref_id, audience)
  values (v, 'general', 'source_document', doc_pub, '{}');
  update public.flags set status = 'in_proposal', proposal_id = v where id = tests.id('flag_pub');
  insert into public.proposals (space_id, author, created_by, title) values (s2, 'curator/test', null, 'B proposal') returning id into v;
  perform tests.put('prop_b', v);
  insert into public.proposal_ops (proposal_id, ord, op, concept_id, path, after) values (v, 0, 'update', c_b, 'b/secret', '{"body":"x"}');

  insert into public.curator_runs (space_id, trigger) values (s1, 'manual') returning id into v;
  perform tests.put('run_s1', v);
  insert into public.curator_tasks (run_id, space_id, step, input) values (v, s1, 'draft', '{"topic":"SECRET finance cluster","concept_paths":["finance/arr"]}');
  insert into public.concept_usage (space_id, concept_id, revision, principal_id, via, query)
  values (s1, c_fin, 1, tests.id('fin_reader'), 'search', 'SECRET board ARR query');
  insert into public.audit_log (workspace_id, space_id, actor, action) values (ws_a, s1, 'system', 'test.event'), (ws_b, s2, 'system', 'test.event');

  -- storage objects (normally written by Edge Functions with the service role)
  insert into storage.objects (bucket_id, name) values
    ('concept-files', s1 || '/' || c_pub || '/notes.md'),
    ('concept-files', s1 || '/' || c_fin || '/calc.py'),
    ('concept-files', s2 || '/' || c_b || '/b.md'),
    ('concept-files', 'not-a-uuid/also-not/x.md'),
    ('sources', s1 || '/' || src_pub || '/m1.txt'),
    ('sources', s1 || '/' || src_fin || '/m2.txt'),
    ('sources', s2 || '/' || src_b || '/b1.txt'),
    ('sources', s1 || '/' || src_pub || '/orphan.txt');
end;
$fixture$;
