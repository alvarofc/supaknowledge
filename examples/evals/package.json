{
  "name": "@supaknowledge/example-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Evals for the knowledge factory: the same agent on a fixed task set before and after curator runs, with task success, flags raised and tool errors per task.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "eval": "node --conditions=supaknowledge-source src/cli.ts",
    "offline": "node --conditions=supaknowledge-source src/cli.ts --offline",
    "test": "node --conditions=supaknowledge-source --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mastra/core": "1.85.0",
    "@supaknowledge/core": "0.1.0",
    "@supaknowledge/example-revenue-report": "0.1.0",
    "@supaknowledge/mastra": "0.1.0",
    "@supaknowledge/sdk": "0.1.0",
    "@supabase/supabase-js": "2.119.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
