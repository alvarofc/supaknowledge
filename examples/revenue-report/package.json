{
  "name": "@supaknowledge/example-revenue-report",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Supaknowledge demo of the knowledge-factory story: an agent hits a renamed column, flags it, a human corrects a report, the curator proposes fixes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./lib": "./src/lib.ts",
    "./memory-store": "./src/memory-store.ts",
    "./agent": "./src/agent.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo": "node --conditions=supaknowledge-source src/demo.ts",
    "offline": "node --conditions=supaknowledge-source src/offline.ts",
    "test": "node --conditions=supaknowledge-source --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mastra/core": "1.85.0",
    "@supaknowledge/core": "0.1.0",
    "@supaknowledge/mastra": "0.1.0",
    "@supaknowledge/sdk": "0.1.0",
    "@supabase/supabase-js": "2.119.2",
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
